@@ -178,6 +185,10 @@
 # ---------- 原模块启用/禁用（只撤销自己放的 disable）----------
 uv_adopt() {
   uv_mod_present || return 1
+  if [ "${uv_keep_module_enabled:-0}" = "1" ]; then
+    uv_log "Keeping $SP_UV_MOD_ID enabled: its service only loads the driver"
+    return 0
+  fi
   if [ ! -f "$SP_UV_MOD_DIR/disable" ]; then
     : > "$SP_UV_MOD_DIR/disable" || return 1
     mkdir -p "$UV_DIR" 2>/dev/null; : > "$UV_MARK_DISABLED"
@@ -708,7 +719,9 @@
   echo "uv_max_temp_mc=$(uv_get max_temp_mc 45000)"
   echo "uv_blocked=${uv_why:-}"
   # 无保护：原模块启用且不在守护之下（不管理，或托管时被人重新启用）
-  if uv_mod_enabled && [ "$uv_m" != "guard" ]; then echo "uv_unmanaged_warning=1"; else echo "uv_unmanaged_warning=0"; fi
+  if [ "${uv_keep_module_enabled:-0}" = "1" ]; then echo "uv_unmanaged_warning=0"
+  elif uv_mod_enabled && [ "$uv_m" != "guard" ]; then echo "uv_unmanaged_warning=1"
+  else echo "uv_unmanaged_warning=0"; fi
   echo "uv_volt_source=$( [ -r "$SP_EEM_DIR/eem_cur_volt" ] && echo eem || { [ -r "$SP_EEM_LITE_DIR/eem_cur_volt" ] && echo eem_lite || echo none; } )"
 }
 
@@ -740,7 +753,11 @@
       [ -n "$uv_tp" ] && [ -n "$(uv_profile_check "$uv_tp")" ] && echo "[WARN] Original module config $uv_tp exceeds the -$(uv_limit) limit (guard mode cannot limit what it writes)" ;;
     managed)
       echo "[ OK ] Control mode=managed"
-      uv_mod_enabled && echo "[WARN] The original module was re-enabled (it will be disabled again at the next boot)" ;;
+      if [ "${uv_keep_module_enabled:-0}" = "1" ]; then
+        echo "[INFO] Managed module kept enabled; its service only loads the driver"
+      else
+        uv_mod_enabled && echo "[WARN] The original module was re-enabled (it will be disabled again at the next boot)"
+      fi ;;
   esac
   case "$(uv_state)" in
     tripped) echo "[HIGH] Circuit breaker tripped: $(cat "$UV_TRIPPED" 2>/dev/null)" ;;
